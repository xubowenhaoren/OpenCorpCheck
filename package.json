{
  "name": "opencorpcheck",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "mcp:f10": "node apps/cli/dist/mcp.js",
    "db:migrate": "node apps/cli/dist/occ.js migrate",
    "backfill": "node apps/worker/dist/cli.js",
    "worker": "node apps/worker/dist/cli.js work",
    "seed": "node apps/cli/dist/occ.js seed",
    "sync:fixtures": "node apps/cli/dist/occ.js sync-fixtures",
    "dev:api": "node apps/api/dist/server.js",
    "dev:qdrant": "scripts/dev-qdrant.sh start",
    "dev:embeddings": "scripts/dev-embeddings.sh start",
    "dev:minio": "scripts/dev-minio.sh start",
    "aliases:sync": "node apps/cli/dist/occ.js aliases sync",
    "snapshots:upload": "node apps/cli/dist/occ.js snapshots upload",
    "e2e:search": "scripts/e2e-search.sh",
    "eval:search": "node scripts/eval-search.mjs"
  }
}
