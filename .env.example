# OpenCorpCheck local development (P2)
# Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgres://occ@127.0.0.1:5432/occdb

# Qdrant (native binary via scripts/dev-qdrant.sh)
OCC_QDRANT_URL=http://127.0.0.1:6333
# OCC_QDRANT_API_KEY=

# Embeddings (local sidecar via scripts/dev-embeddings.sh, or TEI)
OCC_EMBEDDING_URL=http://127.0.0.1:8080
OCC_EMBEDDING_MODEL=BAAI/bge-m3
OCC_EMBEDDING_DIM=1024
OCC_EMBEDDING_VERSION=bge-m3@1024
OCC_EMBEDDING_TIMEOUT_MS=600000

# Optional reranker (downloads bge-reranker-v2-m3 on first use)
OCC_RERANK_ENABLED=false
OCC_RERANK_URL=http://127.0.0.1:8080
OCC_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# API / CLI
OCC_API_PORT=8787
OCC_API_URL=http://127.0.0.1:8787
OCC_FUSION=rrf
OCC_RRF_K=60
OCC_PREFETCH_LIMIT=100

# Collections (change only when reindexing into a new generation)
OCC_QDRANT_COMPANIES=occ_companies
OCC_QDRANT_DOCUMENTS=occ_documents

# Backfill worker (pg-boss)
OCC_RESEARCH_CONCURRENCY=4
OCC_INGEST_CONCURRENCY=4
OCC_F10_CONCURRENCY=4
OCC_REVIEW_CONCURRENCY=2
OCC_SECTIONS_DIR=phase0/out/sections
OCC_FINANCE_ANALYST_URL=http://127.0.0.1:8090

# Agent / worker providers (dual mode, decision 2026-10-31)
# - Interactive ACP sidebar: official DeepSeek API (apps/api, .dsh/acp.patch.yml)
# - Headless research worker: NVIDIA NIM via the local retry gateway + Parallel
#   Search MCP. Put the key in NVIDIA_API_KEY.txt (gitignored) or set it here.
# OCC_LLM_PROVIDER=nvidia            # nvidia (default) | deepseek rollback
# OCC_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# OCC_NIM_GATEWAY_PORT=4010
# OCC_NIM_RPM=20
# OCC_NIM_RETRIES=3
OCC_RESEARCH_TIMEOUT_MS=1800000
# OCC_REVIEW_MODEL=deepseek-flash
# OCC_REVIEW_MAX_CYCLES=2
# OCC_REVIEW_TIMEOUT_MS=480000
# OCC_F10_RELATIONS=on              # none disables F10 shareholder extraction
# OCC_F10_DIR=.occ/f10

# Structured financial statements (F10 cwfx / NewFinancialAnalysis + SEC EDGAR XBRL)
# OCC_FINANCIALS=none               # none stops auto-enqueue after ingest
# OCC_FINANCIALS_CONCURRENCY=2
# OCC_EDGAR_DIR=.occ/edgar
# OCC_EDGAR_CACHE_TTL_MS=86400000
# SEC requires a contact in the User-Agent. The default names the repo owner;
# set OCC_EDGAR_USER_AGENT if a different operator runs the batch.
# OCC_EDGAR_USER_AGENT=OpenCorpCheck/0.1 (Your Name; you@example.com)
# Ownership graph (P1.3): 13F cache lives under $OCC_EDGAR_DIR/13f; DION uses
# the finance-analyst Playwright sidecar (1 request/second).
# OCC_DION_TIMEOUT_MS=60000
# OCC_DION_SETTLE_MS=1500
# OCC_DION_MAX_PAGES=10
# OCC_DION_RATE_PER_SEC=1.0
# Official filing adapters (P1.4): PDF cache + HKEXnews sidecar pacing.
# OCC_FILINGS_DIR=.occ/filings
# OCC_IR_FEEDS=config/ir-feeds.yaml
# OCC_HKEXNEWS_TIMEOUT_MS=60000
# OCC_HKEXNEWS_SETTLE_MS=1500
# OCC_HKEXNEWS_RATE_PER_SEC=1.0
# OCC_HKEXNEWS_CONCURRENCY=2
# Client-side timeout; must exceed the sidecar queue wait (one search ~40 s).
# OCC_HKEXNEWS_CLIENT_TIMEOUT_MS=300000
# Daily company-data/filing refresh (P1.5): data.sweep -> data.source.check ->
# ingest.filing / financials.company. 0 LLM tokens.
# OCC_DATA_SWEEP=on                  # none disables the automatic sweep
# OCC_DATA_SWEEP_CRON=0 8 * * *
# OCC_DATA_TTL_MS=82800000           # 23 h; keep shorter than the daily period
# OCC_DATA_CLAIM_TIMEOUT_MS=1800000  # 30 min lease
# OCC_DATA_CONCURRENCY=4
# OCC_DATA_COLD_DAYS=30
# OCC_DATA_MAX_STEADY_DAYS=30
# OCC_DATA_MAX_ITEMS=20
# OCC_DATA_FIN_RETRY_MAX_DAYS=7       # wait for a lagging A/HK F10 period
# OCC_FILINGS_CONCURRENCY=2
# OCC_FILINGS_FULL_TEXT=0            # 1 follows EDGAR HTML in the automatic path
# NVIDIA_API_KEY=                   # required for live research on NIM
# DEEPSEEK_API_KEY=                 # required for ingest/extraction and reviewer

# Optional snapshot store (MinIO via scripts/dev-minio.sh, or any S3-compatible
# endpoint). Leave unset to disable snapshot upload; ingest keeps working.
# OCC_S3_ENDPOINT=http://127.0.0.1:9000
# OCC_S3_BUCKET=opencorpcheck
# OCC_S3_ACCESS_KEY=minioadmin
# OCC_S3_SECRET_KEY=minioadmin
# OCC_S3_REGION=us-east-1
# OCC_S3_PREFIX=
